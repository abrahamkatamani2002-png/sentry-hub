# Copy to .env for local development. On Vercel, add each of these under
# Project -> Settings -> Environment Variables. Never commit the real values.

# Generate each secret with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PEPPER=

# Neon connection string (use the POOLED one), e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# First admin account - created automatically on first start if no admin exists yet.
# Remove ADMIN_PASSWORD from Vercel once you've signed in.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: your site's address, used in emailed links (invites, password reset).
# Example: https://my-site.vercel.app
PUBLIC_URL=

# Gmail (use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# AWS S3 backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=sentry-hub/backups/
BACKUP_AWS_REGION=eu-west-2
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
# Used to encrypt backups before upload. Keep a copy somewhere safe - without it a backup can't be opened.
BACKUP_PASSPHRASE=

# Vercel sends this as "Authorization: Bearer <value>" when the daily cron runs.
CRON_SECRET=

# Local development only:
# SENTRYHUB_ENV=development
# MAIL_BACKEND=console
